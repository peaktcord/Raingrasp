package(default_visibility = ["//visibility:private"])

# What is Stormhold's own: its profile, its Extension and Variant, its
# dungeon generator, its NPC roster and dialogue trees, its `.cus` sprites
# and its save format. The controller itself is
# //src/common/game:controller.
cc_library(
    name = "stormhold_converted",
    srcs = [
        "cus_image.cpp",
        "dungeon.cpp",
        "dungeon_gen.cpp",
        "npc_script.cpp",
        "extension.cpp",
        "profile.cpp",
        "save_codec.cpp",
        "variant.cpp",
    ],
    hdrs = [
        "cus_image.hpp",
        "dungeon.hpp",
        "dungeon_gen.hpp",
        "npc_script.hpp",
        "extension.hpp",
        "profile.hpp",
        "save_codec.hpp",
        "variant.hpp",
    ],
    copts = CXX_COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    visibility = [
        "//:__pkg__",
        "//src/stormhold:__subpackages__",
    ],
    deps = [
        "//src/common/game:base",
        "//src/common/game:canvas",
        "//src/common/game:combat",
        "//src/common/game:controller",
        "//src/common/game:data",
        "//src/common/game:save",
        "//src/common/game:ui",
        "//src/common/game:visibility",
        "//src/common/game:world",
        "//src/common:runtime",
        "//src/common/render:minimap",
        "//src/common/render:sprite",
        "//src/common/replay:replay",
    ],
)

cc_test(
