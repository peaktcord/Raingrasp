# Can Stormhold be played to its ending? Unlike the sentinel pairs above this
# asserts rather than comparing a dump. Two stages, so a failure names what
# broke: --clear sweeps what the gift points have opened, --beat goes on to
# kill the boss in dungeon 37 and pick up what it drops.
[
    cc_test(
        name = "stormhold_playthrough_%s_test" % stage,
        srcs = ["playthrough_test.cpp"],
        args = [
            "$(rootpath //:stormhold_resources)",
            "--%s" % stage,
        ],
        data = ["//:stormhold_resources"],
        copts = CXX_COPTS,
        size = "medium",
        target_compatible_with = ["@platforms//os:windows"],
        tags = [
            "manual",
            "no-remote",
            "no-remote-cache",
            "no-remote-exec",
            "requires-private-data",
        ],
        visibility = ["//:__pkg__"],
        deps = [
            ":stormhold_converted",
            "//src/common/bot:bot",
            "//src/common/host:game_host",
            "//src/common/platform:crash_trace",
            "//src/common/platform:desktop",
            "//src/common/render:render",
        ],
    )
    for stage in [
        "clear",
    ]
]

# The ending. Kept separate from the list above only because it is the slower
# of the two: it sweeps, sweeps again for the dungeons that opened late, then
# walks to dungeon 37 and kills what is waiting there.
cc_test(
