load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "CXX_COPTS")
load("//bazel:variant_diagnostic.bzl", "variant_diagnostic_pair")

package(default_visibility = ["//visibility:private"])

# What is Dawnstar's own: its profile, its Extension and Variant, its
# dungeon generator, its NPC roster and dialogue trees, and its save format.
# The controller itself is //src/common/game:controller.
cc_library(
    name = "dawnstar_converted",
    srcs = [
        "dungeon.cpp",
        "dungeon_gen.cpp",
        "npc_script.cpp",
        "extension.cpp",
        "profile.cpp",
        "save_codec.cpp",
        "variant.cpp",
    ],
    hdrs = [
        "dungeon.hpp",
        "dungeon_gen.hpp",
        "npc_script.hpp",
        "extension.hpp",
        "profile.hpp",
        "save_codec.hpp",
        "variant.hpp",
    ],
    copts = CXX_COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    visibility = [
        "//:__pkg__",
        "//src/dawnstar:__subpackages__",
    ],
    deps = [
        "//src/common/game:base",
        "//src/common/game:canvas",
        "//src/common/game:combat",
        "//src/common/game:controller",
        "//src/common/game:data",
        "//src/common/game:save",
        "//src/common/game:ui",
        "//src/common/game:visibility",
        "//src/common/game:world",
        "//src/common:runtime",
        "//src/common/render:minimap",
        "//src/common/render:sprite",
        "//src/common/replay:replay",
    ],
)

cc_test(
    name = "world_state_test",
    srcs = ["world_state_test.cpp"],
    copts = CXX_COPTS,
    size = "small",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//:__pkg__"],
    deps = [":dawnstar_converted"],
)

cc_binary(
    name = "dawnstar_data_dump",
    srcs = ["data_dump.cpp"],
    copts = CXX_COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//:__pkg__"],
    deps = [
        ":dawnstar_converted",
        "//src/common/platform:desktop",
        "//src/common/replay:data_harness",
