# A bot that plays the game: walks the dungeons, fights with real rolls,
# loots, equips, and works out the traitor by catching a lie. Shared by the
# playthrough tests below. See bot.hpp for what it does and does not cheat at.
cc_library(
    name = "bot",
    hdrs = ["bot_traitor.hpp"],
    copts = CXX_COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//src/common/sdl:__pkg__"],
    deps = [
        ":dawnstar_converted",
        "//src/common/bot:bot",
    ],
)

# Does the critical path still connect? Unlike the sentinel pairs above this
# asserts rather than comparing a dump: it drives a new character through the
# traitor reveal and the oracle's countdown to the boss, and requires the
# Victory screen at the end. See beat_game_test.cpp for what it cheats at.
cc_test(
    name = "dawnstar_beat_game_test",
    srcs = ["beat_game_test.cpp"],
    args = ["$(rootpath //:dawnstar_resources)"],
    data = ["//:dawnstar_resources"],
    copts = CXX_COPTS,
    size = "small",
    target_compatible_with = ["@platforms//os:windows"],
    tags = [
        "manual",
        "no-remote",
        "no-remote-cache",
        "no-remote-exec",
        "requires-private-data",
    ],
    visibility = ["//:__pkg__"],
    deps = [
        ":bot",
        ":dawnstar_converted",
        "//src/common/host:game_host",
        "//src/common/platform:desktop",
        "//src/common/render:render",
    ],
)


# What save/load does to endgame state. Answers, against the real codec, whether
# the traitor identity survives once questions have been asked and whether the
# oracle countdown survives at all. Takes the resource dir, and optionally a
# save directory to inspect a real save file.
cc_test(
    name = "dawnstar_endgame_save_test",
    srcs = ["endgame_save_test.cpp"],
    args = ["$(rootpath //:dawnstar_resources)"],
    data = ["//:dawnstar_resources"],
    copts = CXX_COPTS,
    size = "small",
    target_compatible_with = ["@platforms//os:windows"],
    tags = [
        "manual",
        "no-remote",
        "no-remote-cache",
        "no-remote-exec",
        "requires-private-data",
    ],
    visibility = ["//:__pkg__"],
    deps = [
        ":dawnstar_converted",
        "//src/common/platform:desktop",
        "//src/common/replay:replay",
    ],
)


# The playthrough tests. One binary, three modes, so a failure names the stage
# that broke. Slower than the sentinel pairs -- these actually play the game.
[
    cc_test(
        name = "dawnstar_playthrough_%s_test" % stage,
        srcs = ["playthrough_test.cpp"],
        args = [
            "$(rootpath //:dawnstar_resources)",
            "--%s" % stage,
        ],
        data = ["//:dawnstar_resources"],
        copts = CXX_COPTS,
        size = "medium",
        target_compatible_with = ["@platforms//os:windows"],
        tags = [
            "manual",
            "no-remote",
            "no-remote-cache",
            "no-remote-exec",
            "requires-private-data",
        ],
        visibility = ["//:__pkg__"],
        deps = [
            ":bot",
            ":dawnstar_converted",
            "//src/common/host:game_host",
            "//src/common/platform:desktop",
            "//src/common/render:render",
        ],
    )
    for stage in [
        "deduce",
        "clear",
        "beat",
    ]
]
