# A paint that throws must not leave the frame lock held.  The lock is not
# recursive, so a leak turned the next paint into resource_deadlock_would_occur
# thrown from inside the error handler, which killed the process.
cc_test(
    name = "paint_lock_test",
    srcs = ["paint_lock_test.cpp"],
    copts = CXX_COPTS,
    size = "small",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//:__pkg__"],
    deps = [
        ":render",
        "//src/common:runtime",
    ],
)

# A frame that throws must leave the game recoverable: the tick reports the
# original failure and the next frame still paints.
cc_test(
    name = "paint_recovery_test",
    srcs = ["paint_recovery_test.cpp"],
    copts = CXX_COPTS,
    size = "small",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//:__pkg__"],
    deps = [
        ":render",
        "//src/common:runtime",
    ],
)
