load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_decomp//decomp:sentinel.bzl", "sentinel_test")
load("//bazel:copts.bzl", "CXX_COPTS")
load("//bazel:private_tool_output.bzl", "file_sha256", "resource_tool_output")

package(default_visibility = ["//visibility:private"])

COMMON_CONSUMERS = [
    "//:__pkg__",
    "//src/common/host:__pkg__",
    "//src/common/sdl:__pkg__",
    "//src/dawnstar:__pkg__",
    "//src/dawnstar:__subpackages__",
    "//src/stormhold:__pkg__",
    "//src/stormhold:__subpackages__",
]

cc_library(
    name = "replay",
    srcs = ["replay.cpp"],
    hdrs = [
        "headless.hpp",
        "replay.hpp",
    ],
    copts = CXX_COPTS,
    visibility = COMMON_CONSUMERS,
    deps = ["//src/common:runtime"],
)

cc_library(
    name = "cli",
    srcs = ["cli.cpp"],
    hdrs = ["cli.hpp"],
    copts = CXX_COPTS,
    visibility = COMMON_CONSUMERS,
    deps = [":replay"],
)

# The characterization harnesses. Each takes the game's profile and
# nothing else names a game (Phase 7); the per-game *_dump.cpp is a main
# that passes its profile in.
cc_library(
    name = "visibility_harness",
    srcs = ["visibility_harness.cpp"],
    hdrs = ["visibility_harness.hpp"],
    copts = CXX_COPTS,
    visibility = [
        "//:__pkg__",
        "//src/dawnstar:__pkg__",
        "//src/stormhold:__pkg__",
    ],
    deps = [
        "//src/common/game:controller",
        "//src/common/game:world",
        "//src/common:runtime",
        "//src/common/platform:desktop",
        ":replay",
    ],
)

cc_library(
    name = "data_harness",
    srcs = ["data_harness.cpp"],
    hdrs = ["data_harness.hpp"],
    copts = CXX_COPTS,
    visibility = [
        "//:__pkg__",
        "//src/dawnstar:__pkg__",
        "//src/stormhold:__pkg__",
    ],
    deps = [
        "//src/common/game:controller",
        "//src/common/game:data",
        "//src/common/game:world",
        "//src/common:runtime",
        "//src/common/platform:desktop",
        ":replay",
    ],
)

cc_library(
    name = "menu_harness",
    srcs = ["menu_harness.cpp"],
    hdrs = ["menu_harness.hpp"],
    copts = CXX_COPTS,
    visibility = [
        "//:__pkg__",
        "//src/dawnstar:__pkg__",
        "//src/stormhold:__pkg__",
    ],
    deps = [
        "//src/common/game:controller",
        "//src/common/game:ui",
        "//src/common/game:world",
        "//src/common:runtime",
        "//src/common/platform:desktop",
        "//src/common/render:render",
        ":replay",
    ],
)

cc_library(
    name = "monster_harness",
    srcs = ["monster_harness.cpp"],
    hdrs = ["monster_harness.hpp"],
    copts = CXX_COPTS,
    visibility = [
        "//:__pkg__",
        "//src/dawnstar:__pkg__",
        "//src/stormhold:__pkg__",
    ],
    deps = [
        "//src/common/game:controller",
        "//src/common/game:ui",
        "//src/common/game:world",
        "//src/common:runtime",
        "//src/common/platform:desktop",
        ":replay",
    ],
)

cc_library(
    name = "player_harness",
    srcs = ["player_harness.cpp"],
    hdrs = ["player_harness.hpp"],
    copts = CXX_COPTS,
    visibility = [
        "//:__pkg__",
        "//src/dawnstar:__pkg__",
        "//src/stormhold:__pkg__",
    ],
    deps = [
        "//src/common/game:base",
        "//src/common/game:combat",
        "//src/common/game:controller",
        "//src/common/game:ui",
        "//src/common/game:world",
        "//src/common:runtime",
        "//src/common/platform:desktop",
        ":replay",
    ],
