# The replay probe for both games. Which game it drives is `--game`; each
# game's script and state hash come through the host seam.
REPLAY_PROBE_DEPS = [
    ":cli",
    ":replay",
    "//src/common/host:registry",
    "//src/common:runtime",
    "//src/common/platform:desktop",
    "//src/common/platform:platform",
    "//src/common/render:render",
]

cc_binary(
    name = "raingrasp_replay",
    srcs = ["probe_main.cpp"],
    copts = CXX_COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//:__pkg__"],
    deps = REPLAY_PROBE_DEPS,
)

_PRIVATE_TEST_TAGS = [
    "manual",
    "no-remote",
    "no-remote-cache",
    "no-remote-exec",
    "requires-private-data",
]

resource_tool_output(
    name = "dawnstar_replay_output",
    args = ["--game", "dawnstar"],
    resources = "//:dawnstar_resources",
    tool = ":raingrasp_replay",
    tool_writes_output = True,
    tags = _PRIVATE_TEST_TAGS,
    visibility = ["//:__pkg__"],
)

file_sha256(
    name = "dawnstar_replay_digest",
    src = ":dawnstar_replay_output",
    tags = _PRIVATE_TEST_TAGS,
)

sentinel_test(
    name = "dawnstar_replay_test",
    actual = ":dawnstar_replay_digest",
    expected = "//:validation/sentinels/dawnstar-replay.sha256",
    size = "medium",
    tags = _PRIVATE_TEST_TAGS,
    visibility = ["//:__pkg__"],
)

resource_tool_output(
    name = "stormhold_replay_output",
    args = ["--game", "stormhold"],
    resources = "//:stormhold_resources",
    tool = ":raingrasp_replay",
    tool_writes_output = True,
    tags = _PRIVATE_TEST_TAGS,
    visibility = ["//:__pkg__"],
)

file_sha256(
    name = "stormhold_replay_digest",
    src = ":stormhold_replay_output",
    tags = _PRIVATE_TEST_TAGS,
)

sentinel_test(
    name = "stormhold_replay_test",
    actual = ":stormhold_replay_digest",
    expected = "//:validation/sentinels/stormhold-replay.sha256",
    size = "medium",
    tags = _PRIVATE_TEST_TAGS,
    visibility = ["//:__pkg__"],
)
