# ------------------------------------------------------------------- shared
#
# One shared runtime and one rasterizer serve both ports; only the transliterated game
# classes and the front-ends that reach into them are per-game.

# Transitional aliases keep the established root labels stable while consumers
# move into their own packages. They are root-private so new packages must name
# the real boundary instead of extending the old public root API.
alias(
    name = "platform",
    actual = "//src/common/platform:platform",
    visibility = ["//:__pkg__"],
)

alias(
    name = "inflate",
    actual = "//src/common/platform:inflate",
    visibility = ["//:__pkg__"],
)

alias(
    name = "platform_desktop",
    actual = "//src/common/platform:desktop",
    visibility = ["//:__pkg__"],
)

alias(
    name = "platform_intake",
    actual = "//src/common/platform:intake",
    visibility = ["//:__pkg__"],
)

alias(
    name = "runtime_support",
    actual = "//src/common:runtime",
    visibility = ["//:__pkg__"],
)

alias(
    name = "minimap",
    actual = "//src/common/render:minimap",
    visibility = ["//:__pkg__"],
)

# Software rasterizer implementing MIDP Graphics and Nokia DirectGraphics. The
# games paint from their own threads, so frames are built on the CPU and handed
# to SDL to present; this also keeps the renderer testable without a display.
alias(
    name = "render",
    actual = "//src/common/render:render",
    visibility = ["//:__pkg__"],
)

# Widescreen dungeon view. Knows neither game: each supplies a Scene describing
# its art and what is beside the player (see <game>/render/widescreen_scene).
# Top-down dungeon maps: one per dungeon, plus every dungeon stitched together
# at the offsets their geometry tables imply.
alias(
    name = "map_atlas",
    actual = "//src/common/render:map_atlas",
    visibility = ["//:__pkg__"],
)

alias(
    name = "widescreen",
    actual = "//src/common/render:widescreen",
    visibility = ["//:__pkg__"],
)

# Real 3D dungeon view, drawn with a camera measured from the original wall art.
alias(
    name = "raycast",
    actual = "//src/common/render:raycast",
    visibility = ["//:__pkg__"],
)

alias(
    name = "menu_shortcuts",
    actual = "//src/common/input:menu_shortcuts",
    visibility = ["//:__pkg__"],
)

