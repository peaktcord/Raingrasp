# DEFLATE and the zip reader, against fixtures produced by an independent
# implementation (Python's zlib) and against hand-built archives whose every
# offset is known. Sealed. Its companion inflate_jar_test runs the same decoder
# over the user's real JARs.
cc_test(
    name = "inflate_unit_test",
    srcs = ["tests/inflate_unit_test.cpp"],
    copts = COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":inflate"],
)

# Runs the vendored inflater over a real JAR and digests every entry, so the
# decoder can be checked against a trusted implementation on the actual archives
# rather than only on hand-picked streams. Private: it needs the user's JARs.
cc_binary(
    name = "inflate_jar_dump",
    srcs = ["tests/inflate_jar_dump.cpp"],
    copts = COPTS,
    tags = [
        "manual",
        "requires-private-data",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":inflate"],
)

# The same decoder, over the user's real archives. Bazel generates the expected
# report from Python's zipfile, so this checks an independent implementation
# without committing an inventory of proprietary archive contents.
cc_test(
    name = "inflate_jar_test",
    srcs = ["tests/inflate_jar_dump.cpp"],
    args = [
        "$(rootpath artifacts/private/jars/tes-travels-dawnstar-1.0.0.jar)",
        "$(rootpath artifacts/private/jars/tes-travels-stormhold-1.0.10.jar)",
        "--check",
        "$(rootpath :jar_entries_expected)",
    ],
    data = [
        "artifacts/private/jars/tes-travels-dawnstar-1.0.0.jar",
        "artifacts/private/jars/tes-travels-stormhold-1.0.10.jar",
        ":jar_entries_expected",
    ],
    copts = COPTS,
    size = "small",
    tags = [
        "manual",
        "no-remote",
        "no-remote-cache",
        "no-remote-exec",
        "requires-private-data",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":inflate"],
)

# A command-line front door to native intake, so the C++ unpacker can be run
# from a script and diffed against bazel/intake.py's tree.
cc_binary(
    name = "intake_native_dump",
    srcs = ["tests/intake_native_dump.cpp"],
    copts = COPTS,
    tags = [
        "manual",
        "requires-private-data",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":platform_intake"],
)

# The two unpackers must produce the same tree, because either one's output is
# read by the same runtime. This already caught a real divergence: the native
# side lowercased .lmp member names, which is invisible on Windows and would
# have lost three case-sensitively-named images under wasm.
python_tool_test(
    name = "intake_parity_test",
    script = "tests/intake_parity_test.py",
    tool = ":intake_native_dump",
    args_files = [
        "//bazel:intake.py",
        "artifacts/private/jars/tes-travels-dawnstar-1.0.0.jar",
        "artifacts/private/jars/tes-travels-stormhold-1.0.10.jar",
    ],
    size = "small",
    tags = [
        "manual",
        "no-remote",
        "no-remote-cache",
        "no-remote-exec",
        "requires-private-data",
    ],
    target_compatible_with = ["@platforms//os:windows"],
)

# Native intake against the user's real JARs: identification, unpacking, and
# the resolution precedence. Private, because the question is whether a player's
# own file produces a tree the game can boot from -- which synthesised archives
# cannot answer. bazel/intake.py's rules are covered separately and sealed by
# intake_test; the two implementations must agree, since either one's tree is
# read by the same runtime.
cc_test(
    name = "intake_native_test",
    srcs = ["tests/intake_native_test.cpp"],
    args = [
        "$(rootpath artifacts/private/jars/tes-travels-dawnstar-1.0.0.jar)",
        "$(rootpath artifacts/private/jars/tes-travels-stormhold-1.0.10.jar)",
    ],
    data = [
        "artifacts/private/jars/tes-travels-dawnstar-1.0.0.jar",
        "artifacts/private/jars/tes-travels-stormhold-1.0.10.jar",
    ],
    copts = COPTS,
    size = "small",
    tags = [
        "manual",
        "no-remote",
        "no-remote-cache",
        "no-remote-exec",
        "requires-private-data",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":platform_intake"],
)

# The VFS guarantees: normalisation, layer precedence and the .lmp reader.
# Sealed -- it builds its archives in memory, so it needs neither the private
# JARs nor a filesystem, and it covers the two failure modes no game baseline
# can (a name that resolves on one platform's casing rules but not the other's,
# and an override that silently loses to the layer beneath it).
# The Display & Controls defaults and the handset preset. `hold-to-move` is
# the row that starts off.
