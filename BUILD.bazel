# `single-save-slot`: the save store replaces a save atomically. There is one
# slot per game now, so an interrupted write has no older sibling to fall back
# on -- the temp-and-rename in DirectorySaveStore::save is the only thing
# keeping a half-written save from destroying a good one, and this pins it.
cc_test(
    name = "atomic_save_test",
    srcs = ["tests/atomic_save_check.cpp"],
    copts = COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":platform",
        ":platform_desktop",
        "//src/common:runtime",
    ],
)

# The shared monster table lookups and save record, swept rather than sampled.
# Sealed: the table is synthetic, so every type and column is reachable without
# the private JARs -- which is the payoff of the extraction, since these were
# previously exercised only through whichever types a dungeon walk happened to
# touch.
cc_test(
    name = "monsterdata_unit_test",
    srcs = ["tests/monsterdata_unit_test.cpp"],
    copts = COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["//src/common/game:data"],
)

# The shared combat arithmetic, swept rather than sampled. Sealed: the item
# table is synthetic, so every weapon and cuirass category, every armour slot
# and every spell effect is reachable without the private JARs -- which is the
# payoff of the extraction, since these were previously exercised only through
# whichever equipment a scripted play-through happened to hold.
# Vitals clamping and spell-timer state, swept rather than sampled. Sealed:
# both arrays are constructed by the test, so every spell slot, every sentinel
# and every cur/max pairing is reachable without the private JARs. The pairing
# sweep is the point -- a current vital clamped against the wrong maximum is
# invisible on a fresh character, where cur and max are equal by construction.
# The inventory, swept on its post-conditions rather than its returns. Sealed:
# the item table and the three parallel arrays are all built by the test.
# These functions mutate storage the save format depends on, so a right return
# value with wrong arrays would corrupt the next save -- every mutation is
# checked by inspecting the arrays, against a whole-bag invariant.
# The batched small helpers. Sealed: the spell table and both byte streams are
# built by the test. isWalkable's domain is one byte, so it is swept
# exhaustively rather than sampled; describeSpell's newline placement is
# checked as a contract, since the caller splits on it to lay out the screen.
cc_test(
    name = "menuwidget_unit_test",
    srcs = ["tests/menuwidget_unit_test.cpp"],
    copts = COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["//src/common/game:ui"],
)

